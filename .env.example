# ==============================================================================
# InboxIQ - Master Environment Configuration Template (.env.example)
# Copy this file to .env and supply actual values for local development.
# Never commit real API keys, secrets, or passwords to version control.
# ==============================================================================

# Application & Server Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
APP_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inboxiq
DB_USERNAME=inboxiq_user
DB_PASSWORD=inboxiq_secure_dev_password
POSTGRES_PORT=5432

# Application Authentication (JWT)
# 512-bit Base64 secret key for HS512 JWT signing
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970337336763979244226452948404D635166546A576E5A7234753778214125442A
JWT_EXPIRY_MS=900000
REFRESH_TOKEN_EXPIRY_MS=604800000

# Google OAuth Refresh Token Encryption (AES-256-GCM)
# Must be exactly 256 bits (32 bytes / 64 hex characters or 44 base64 characters)
TOKEN_ENCRYPTION_KEY=6b5970337336763979244226452948404d635166546a576e5a72347537782141
TOKEN_ENCRYPTION_KEY_VERSION=v1

# Google OAuth 2.0 Credentials (Gmail API)
# Create in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/accounts/google/callback

# Google Gemini API (Spring AI)
GEMINI_API_KEY=your-gemini-api-key
AI_MODEL_NAME=gemini-1.5-flash
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=2048

# SMS Provider Configuration (twilio | msg91)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# Frontend Next.js Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
PORT=3000
